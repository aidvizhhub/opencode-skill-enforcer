{
  "name": "opencode-skill-enforcer",
  "version": "0.1.0",
  "description": "OpenCode V2 plugin: attaches relevant skills and documentation chunks to every prompt and makes the agent actually load them",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aidvizhhub/opencode-skill-enforcer.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "skills",
    "context",
    "llm"
  ],
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "probe": "bun run scripts/probe.ts",
    "probe:quality": "bun run scripts/probe.ts quality",
    "probe:live": "bun run scripts/probe.ts live",
    "probe:en": "bun run scripts/en-check.ts",
    "probe:stem": "bun run scripts/stem-check.ts",
    "probe:triggers": "bun run scripts/backfill-triggers.ts",
    "probe:triggers2": "bun run scripts/add-triggers.ts"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.18"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^5.8.2"
  }
}
